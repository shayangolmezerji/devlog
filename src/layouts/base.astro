---
const { title, description = '', home = './' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1c1e21;
        --muted: #63666a;
        --accent: #0b5cad;
        --code-bg: #f2f3f5;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #17191e;
          --fg: #d7dade;
          --muted: #9a9ea3;
          --accent: #86bae8;
          --code-bg: #22252b;
        }
      }
      body {
        margin: 2.5rem auto 5rem;
        max-width: 70ch;
        padding: 0 1.25rem;
        background: var(--bg);
        color: var(--fg);
        font: 17px/1.65 system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
      }
      header.site a {
        color: var(--fg);
        font-weight: 600;
        text-decoration: none;
      }
      main {
        margin-top: 2.5rem;
      }
      h1 {
        font-size: 1.6rem;
        line-height: 1.3;
        margin-bottom: 0.25rem;
      }
      h2 {
        font-size: 1.2rem;
        margin-top: 2.2rem;
      }
      a {
        color: var(--accent);
      }
      .meta {
        color: var(--muted);
        font-size: 0.9rem;
      }
      code {
        background: var(--code-bg);
        padding: 0.1em 0.3em;
        border-radius: 3px;
      }
      pre {
        background: var(--code-bg);
        padding: 0.9rem 1rem;
        border-radius: 5px;
        overflow-x: auto;
        line-height: 1.5;
      }
      pre code {
        background: none;
        padding: 0;
      }
      code,
      pre {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas,
          "Liberation Mono", monospace;
        font-size: 0.92em;
      }
      ul.post-list {
        list-style: none;
        padding: 0;
      }
      ul.post-list li {
        margin-bottom: 1.6rem;
      }
    </style>
  </head>
  <body>
    <header class="site">
      <a href={home}>devlog</a>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
